{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperlight",
  "version": "1.1.0",
  "identifier": "com.paperlight.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "A spotlight for every document on your PC",
    "longDescription": "Paperlight finds, tracks and opens every PDF, Word, Excel and PowerPoint file on your PC from one fast, minimal window — without moving your files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3MUE2RUMxRjY2NEFGODkKUldTSnIyVDJ3VzRhTitYTG5STE5IT0pSU2tIR0dxVnV6Q1UvNi9Fd0NDalZ1enlobE1ZZjU3ZysK",
      "endpoints": [
        "https://github.com/webKing021/paperlight/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
